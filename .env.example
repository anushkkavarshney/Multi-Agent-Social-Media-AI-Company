[TEMPLATE]
# =============================================================================
# Prodigal AI Task 1 — environment template  (architecture doc, section 11)
# Copy to `.env` and adjust. Everything here is LOCAL — no hosted APIs anywhere.
#   cp .env.example .env
# =============================================================================

# --- Ollama ------------------------------------------------------------------
# Host of the local Ollama daemon. Install: https://ollama.com/download
# Verify it's up:  curl http://localhost:11434/api/tags
OLLAMA_HOST=http://localhost:11434

# Primary generation model (7-8B class; good instruction-following on consumer HW)
PRIMARY_MODEL=qwen2.5:7b-instruct
# Small fast model for routing / classification / validation only
ROUTER_MODEL=qwen2.5:3b-instruct
# Local embedding model (memory layer, Day 2+); never a hosted embedding API
EMBEDDING_MODEL=nomic-embed-text
# HTTP read timeout for the Ollama client (seconds). 600 suits CPU-only hosts
# where the first call per model spends minutes loading weights into RAM.
OLLAMA_TIMEOUT_SECONDS=600

# Structured-output retry budget per model call (then raise ModelOutputFailure)
MAX_STRUCTURED_RETRIES=3

# Compliance retry budget per post (then escalate to needs_human; owned by
# orchestration/retry_policy.py)
MAX_COMPLIANCE_RETRIES=3

# --- Mock platform -----------------------------------------------------------
# SQLite file the FastAPI app persists to (created on first boot, seeded with
# 3 channels on startup when CREATE_TABLES_ON_STARTUP is true).
DB_PATH=./platform.db
CREATE_TABLES_ON_STARTUP=true

# Simulation defaults (config-driven so Analytics experiments can re-tune them)
SIM_SEED=42

# --- Trace logging ----------------------------------------------------------
# Every model call (tokens, latency, success/failure) is appended here as JSONL.
TRACE_LOG_PATH=./logs/agent_trace.jsonl
TRACE_LOG_ENABLED=true
